# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Starship prompt — must be after oh-my-zsh
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# bat (syntax-highlighted cat) — Ubuntu ships the binary as `batcat`
if command -v batcat >/dev/null 2>&1; then
  alias cat="batcat"
  alias bat="batcat"
fi

# uv / locally-installed binaries
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# fnm (replaces nvm)
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --use-on-cd)"
fi

# fzf (Ctrl+R history, Ctrl+T files, Alt+C cd)
# `fzf --zsh` needs fzf >= 0.48; Ubuntu ships older, so fall back to the
# example scripts the Debian package installs.
export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/.git/*"'
if fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
else
  [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
  [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
fi

# opencode (installer puts it in ~/.opencode/bin); its OpenCode Go key is read
# from opencode's own auth file at runtime, never stored here.
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"
[ -r ~/.local/share/opencode/auth.json ] && export OPENCODE_API_KEY="$(jq -r '."opencode-go".key // empty' ~/.local/share/opencode/auth.json)"
# flyctl and bun, when installed
[ -d "$HOME/.fly/bin" ] && export FLYCTL_INSTALL="$HOME/.fly" && export PATH="$FLYCTL_INSTALL/bin:$PATH"
[ -d "$HOME/.bun/bin" ] && export BUN_INSTALL="$HOME/.bun" && export PATH="$BUN_INSTALL/bin:$PATH"

# zoxide (z command) — must be last
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Auto-attach to the tmux session "fleet" if it exists, else "main" (or create
# it). Interactive shells only, so provisioning/`ssh host <cmd>` runs are never
# swallowed by tmux.
# A fresh tmux server starts in fleet.slice (low CPU/IO weight): tmux puts
# every pane in its server's slice, so agents can't starve sshd/tailscaled.
if [[ $- == *i* ]] && command -v tmux >/dev/null 2>&1 && [ -z "$TMUX" ]; then
  tmux ls >/dev/null 2>&1 || systemd-run --user --scope --quiet --slice=fleet.slice \
    --unit=default-tmux tmux new-session -d -s main 2>/dev/null
  tmux attach -t fleet 2>/dev/null || tmux attach -t main 2>/dev/null || tmux new -s main
fi

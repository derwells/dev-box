# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Starship prompt — must be after oh-my-zsh
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# bat (syntax-highlighted cat) — Ubuntu ships the binary as `batcat`
if command -v batcat >/dev/null 2>&1; then
  alias cat="batcat"
  alias bat="batcat"
fi

# uv / locally-installed binaries
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# fnm (replaces nvm)
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --use-on-cd)"
fi

# fzf (Ctrl+R history, Ctrl+T files, Alt+C cd)
# `fzf --zsh` needs fzf >= 0.48; Ubuntu ships older, so fall back to the
# example scripts the Debian package installs.
export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/.git/*"'
if fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
else
  [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
  [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
fi


# zoxide (z command) — must be last
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Auto-attach to tmux session "main" (or create it). Interactive shells only,
# so provisioning/`ssh host <cmd>` runs are never swallowed by tmux.
if [[ $- == *i* ]] && command -v tmux >/dev/null 2>&1 && [ -z "$TMUX" ]; then
  tmux attach -t main 2>/dev/null || tmux new -s main
fi

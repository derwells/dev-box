#cloud-config

users:
  - name: ${username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${file("~/.ssh/id_ed25519.pub")}

package_update: true
package_upgrade: true

packages:
  - ufw
  - xfce4
  - xfce4-goodies
  - dbus-x11
  - tigervnc-standalone-server
  - tigervnc-common
  - novnc
  - websockify
  - chromium-browser
  - git
  - curl
  - unzip
  - jq
  - tmux

runcmd:
  # GitHub CLI
  - curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg
  - chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
  - apt-get update -qq && apt-get install -y gh

  # GitHub auth (headless) — lets git/gh clone private repos without an interactive login
%{ if github_token != "" ~}
  - su - ${username} -c 'echo "${github_token}" | gh auth login --with-token'
  - su - ${username} -c 'gh auth setup-git'
%{ else ~}
  # No github_token provided — run `gh auth login` manually after first login
%{ endif ~}

  # Tailscale
  - curl -fsSL https://tailscale.com/install.sh | sh
%{ if tailscale_auth_key != "" ~}
  - tailscale up --ssh --authkey=${tailscale_auth_key}
%{ else ~}
  # No auth key provided — run `sudo tailscale up --ssh` manually after first login
%{ endif ~}

  # Firewall (UFW)
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow in on tailscale0
  - ufw allow 22/tcp
  - ufw --force enable

  # Node.js via fnm
  - su - ${username} -c 'curl -fsSL https://fnm.vercel.app/install | bash'
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && fnm install --lts && fnm use --lts'

  # Claude Code
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && npm install -g @anthropic-ai/claude-code get-shit-done-cc'

  # GSD (registers skills + hooks into ~/.claude/)
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && GSD_PORTABLE_HOOKS=1 npx get-shit-done-cc@latest --claude --global'

  # Claude Code settings (GSD may have written hooks already, so merge carefully)
  - su - ${username} -c 'mkdir -p /home/${username}/.claude'
  - |
    cat > /tmp/claude-settings-patch.js << 'PATCHSCRIPT'
    const fs = require('fs');
    const settingsPath = process.env.HOME + '/.claude/settings.json';
    let settings = {};
    try { settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8')); } catch {}
    Object.assign(settings, {
      effortLevel: "medium",
      promptSuggestionEnabled: false,
      tui: "fullscreen",
      autoMemoryEnabled: false,
      skipDangerousModePermissionPrompt: true,
      theme: "light"
    });
    // Claude Code attention icons: set a tmux window var that ~/.tmux.conf
    // renders (🔔 = needs input, ✅ = finished). Merge into hooks without
    // clobbering GSD's own hooks (SessionStart/PreToolUse/PostToolUse).
    settings.hooks = settings.hooks || {};
    settings.hooks.Notification = [
      { hooks: [{ type: "command", command: "[ -n \"$TMUX_PANE\" ] && tmux set -w -t \"$TMUX_PANE\" @ci '🔔 ' || true" }] }
    ];
    settings.hooks.Stop = [
      { hooks: [{ type: "command", command: "[ -n \"$TMUX_PANE\" ] && tmux set -w -t \"$TMUX_PANE\" @ci '✅ ' || true" }] }
    ];
    fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2));
    PATCHSCRIPT
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && node /tmp/claude-settings-patch.js'
  - rm /tmp/claude-settings-patch.js
  - |
    cat > /home/${username}/.claude/CLAUDE.md << 'CLAUDEMD'
    # graphify
    - **graphify** (`~/.claude/skills/graphify/SKILL.md`) - any input to knowledge graph. Trigger: `/graphify`
    When the user types `/graphify`, invoke the Skill tool with `skill: "graphify"` before doing anything else.
    CLAUDEMD

  # tmux config (mirrors local ~/.tmux.conf)
  - |
    cat > /home/${username}/.tmux.conf << 'TMUXCONF'
    # Mouse support (click panes, resize, scroll)
    set -g mouse on

    # Start window/pane numbering at 1 (0 is far from the other keys)
    set -g base-index 1
    setw -g pane-base-index 1

    # Renumber windows when one is closed
    set -g renumber-windows on

    # More scrollback history
    set -g history-limit 10000

    # Faster escape (default 500ms feels laggy)
    set -sg escape-time 10

    # Split panes with | and - (easier to remember than % and ")
    bind | split-window -h -c "#{pane_current_path}"
    bind - split-window -v -c "#{pane_current_path}"

    # New windows open in the same directory
    bind c new-window -c "#{pane_current_path}"

    # Reload config with r
    bind r source-file ~/.tmux.conf \; display "Config reloaded"

    # Status bar - clean and minimal
    set -g status-style 'bg=default fg=white'
    set -g status-left '[#S] '
    set -g status-right ''

    # Claude Code attention icons (set by Notification/Stop hooks via @ci)
    # 🔔 = needs your input, ✅ = finished a turn, empty = working / already seen
    setw -g window-status-format         '#{@ci}#I:#W'
    setw -g window-status-current-format '#{@ci}#I:#W'

    # Clear the icon as soon as you focus that pane/window
    set -g focus-events on
    set-hook -g pane-focus-in 'set -uw @ci'
    TMUXCONF
  - chown ${username}:${username} /home/${username}/.tmux.conf

  # Skills: humanizer
  - su - ${username} -c 'git clone https://github.com/blader/humanizer.git /home/${username}/.claude/skills/humanizer'

  # Plugins: add marketplace, then install
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && claude plugin marketplace add anthropics/claude-plugins-official'
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && claude plugin install superpowers@claude-plugins-official'
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && claude plugin install context7@claude-plugins-official'
  - chown -R ${username}:${username} /home/${username}/.claude

  # Playwright
  - su - ${username} -c 'export PATH="/home/${username}/.local/share/fnm:$PATH" && eval "$(fnm env)" && npx playwright install --with-deps'

  # VNC setup
  - su - ${username} -c 'mkdir -p /home/${username}/.vnc'
  - |
    cat > /home/${username}/.vnc/xstartup << 'XSTARTUP'
    #!/bin/sh
    unset SESSION_MANAGER
    unset DBUS_SESSION_BUS_ADDRESS
    exec startxfce4
    XSTARTUP
  - chmod +x /home/${username}/.vnc/xstartup
  - chown -R ${username}:${username} /home/${username}/.vnc

  # VNC systemd service
  - |
    cat > /etc/systemd/system/vncserver@.service << 'VNCUNIT'
    [Unit]
    Description=TigerVNC server on display %i
    After=syslog.target network.target tailscaled.service

    [Service]
    Type=forking
    User=${username}
    WorkingDirectory=/home/${username}
    ExecStartPre=/bin/sh -c 'sleep 5'
    ExecStart=/usr/bin/vncserver :%i -localhost no -geometry 1920x1080 -depth 24
    ExecStop=/usr/bin/vncserver -kill :%i

    [Install]
    WantedBy=multi-user.target
    VNCUNIT

  # noVNC systemd service
  - |
    cat > /etc/systemd/system/novnc.service << 'NOVNCUNIT'
    [Unit]
    Description=noVNC websocket proxy
    After=vncserver@1.service

    [Service]
    Type=simple
    User=${username}
    ExecStart=/usr/bin/websockify --web /usr/share/novnc 6080 localhost:5901
    Restart=on-failure

    [Install]
    WantedBy=multi-user.target
    NOVNCUNIT

  - systemctl daemon-reload
  # VNC requires a password — user must run `vncpasswd` before enabling
  # Then: sudo systemctl enable --now vncserver@1 novnc

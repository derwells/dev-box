#cloud-config
# Bootstrap only: user, packages, GitHub CLI/auth, Tailscale, firewall.
# Everything else is provisioned by setup.sh over SSH (see main.tf) because
# Hetzner hard-caps user_data at 32KiB and the full payload is far larger.

users:
  - name: ${username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true

packages:
  - ufw
  - xfce4
  - xfce4-goodies
  - dbus-x11
  - tigervnc-standalone-server
  - tigervnc-common
  - novnc
  - websockify
  - chromium-browser
  - git
  - curl
  - unzip
  - jq
  - tmux
  - python3
  # Interactive shell environment (mirrors the local WSL box)
  - zsh
  - fzf
  - bat
  - zoxide

runcmd:
  # GitHub CLI
  - curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg
  - chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
  - apt-get update -qq && apt-get install -y gh

  # GitHub auth (headless) — lets git/gh clone private repos without an interactive login
%{ if github_token != "" ~}
  - su - ${username} -c 'echo "${github_token}" | gh auth login --with-token'
  - su - ${username} -c 'gh auth setup-git'
%{ else ~}
  # No github_token provided — run `gh auth login` manually after first login
%{ endif ~}

  # Tailscale
  - curl -fsSL https://tailscale.com/install.sh | sh
%{ if tailscale_auth_key != "" ~}
  - tailscale up --ssh --authkey=${tailscale_auth_key}
%{ else ~}
  # No auth key provided — run `sudo tailscale up --ssh` manually after first login
%{ endif ~}

  # Firewall (UFW)
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow in on tailscale0
  - ufw allow 22/tcp
  - ufw --force enable
